{
  "name": "dsh-hub",
  "version": "0.2.1",
  "description": "Make one DeepSeek Harness the hub of your computers: a chat page for your phone and browsers, accounts, and the other computers joined as nodes the agent can run work on.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RustColeone/dsh-deepseek-bot.git"
  },
  "homepage": "https://github.com/RustColeone/dsh-deepseek-bot#readme",
  "engines": {
    "node": ">=22.13"
  },
  "main": "plugin/index.js",
  "bin": {
    "dsh-hub": "bin/dsh-hub.js"
  },
  "exports": {
    ".": "./plugin/index.js",
    "./client": "./plugin/client.js",
    "./lib/*": "./lib/*.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "lib",
    "plugin",
    "static",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "hub": "node bin/dsh-hub.js hub",
    "node": "node bin/dsh-hub.js node"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "self-hosted",
    "remote",
    "agent"
  ],
  "dependencies": {
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-home-paths": "*",
    "@deepseek-ai/dsh-llm": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-home-paths": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "devDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
